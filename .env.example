# Copy to .env and fill in. .env is git-ignored; never commit it.
# Create an API key at kalshi.com (Account -> API keys). Kalshi shows the
# private key once: save it as a .pem file outside the repo, or in secrets/.

KALSHI_API_KEY_ID=your-key-id-uuid
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# Production (default). Demo: https://external-api.demo.kalshi.co/trade-api/v2
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Live trading stays locked until this is 1.
BTCLAB_ENABLE_LIVE=0

# BTCLAB_LOG=INFO
